# =================================================================
# CẤU HÌNH TÀI KHOẢN VÀ COOKIES CHO AUTOEDU SOLVER
# Sao chép tệp này thành .env và điền các giá trị tương ứng
# =================================================================

# 1. Cookies xác thực Google Gemini Web (Miễn phí 100%, không cần API Key)
# Lấy từ F12 -> Application -> Cookies -> https://gemini.google.com
GEMINI_SECURE_1PSID=your_secure_1psid_here
GEMINI_SECURE_1PSIDTS=your_secure_1psidts_here
GEMINI_SECURE_1PSIDCC=your_secure_1psidcc_here

# Các cookie phụ trợ (tùy chọn giúp duy trì phiên tốt hơn)
GEMINI_SID=
GEMINI_HSID=
GEMINI_SSID=
GEMINI_APISID=
GEMINI_SAPISID=
GEMINI_SECURE_1PAPISID=
GEMINI_SECURE_3PAPISID=
GEMINI_SECURE_3PSID=
GEMINI_SECURE_3PSIDTS=
GEMINI_SECURE_3PSIDCC=
GEMINI_SIDCC=

# 2. Thông tin đăng nhập Onluyen.vn (Tùy chọn tự động đăng nhập khi hết phiên)
ONLUYEN_USERNAME=your_username_here
ONLUYEN_PASSWORD=your_password_here

# 3. Đường dẫn cấu hình trình duyệt (Mặc định tự nhận diện)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# BROWSER_USER_DATA_DIR=~/.onluyen-browser-profile

# 4. Cấu hình gửi thông báo Discord & Telegram (Tùy chọn)
# Lấy từ Discord Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# Lấy từ Telegram @BotFather và @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
